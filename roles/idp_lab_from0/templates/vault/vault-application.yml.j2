---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ idp_lab_from0_vault_application_name }}
  namespace: {{ idp_lab_from0_vault_application_namespace }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io/foreground
spec:
  destination:
    namespace: {{ idp_lab_from0_vault_namespace }}
    server: 'https://kubernetes.default.svc'
  project: default
  ignoreDifferences:
    - group: admissionregistration.k8s.io
      kind: MutatingWebhookConfiguration
      jqPathExpressions:
        - '.webhooks[]?.clientConfig.caBundle'
  source:
    path: {{ idp_lab_from0_vault_gitops_repo_path }}
    repoURL: {{ idp_lab_from0_vault_gitops_repo }}
    targetRevision: {{ idp_lab_from0_vault_gitops_repo_tag }}
    helm:
      values: |
        nameOverride: {{ idp_lab_from0_vault_name }}
        kubernetes:
          apiserver: {{ r_openshift_api_server }}
        vault:
          auth:
            namespace: {{ idp_lab_from0_vault_auth_namespace }}
  syncPolicy:
    automated: {}
    syncOptions:
      - CreateNamespace=true
